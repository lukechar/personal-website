---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ProjectCard from '../components/ProjectCard.astro';
import avatar from '../assets/luke_pass.jpg';
import { projects } from '../data/projects';
import { site } from '../data/site';

const featured = projects.filter((p) => p.featured);
---

<Base>
  <section class="container hero">
    <Image
      src={avatar}
      alt="Luke at the top of Mummy Pass in northern Colorado"
      widths={[176, 352]}
      sizes="176px"
      class="avatar"
      loading="eager"
    />
    <div>
      <p class="eyebrow">{site.title}</p>
      <h1>Hi, I’m Luke.</h1>
      <p class="lede">
        I build data processing pipelines for NASA missions at the <a href="https://lasp.colorado.edu/" rel="noopener noreferrer">Laboratory for Atmospheric and Space Physics</a> in Boulder, Colorado. Before software, I was an experimental physicist working with ultrafast lasers, and I still enjoy work where code meets real-world measurement.
      </p>
      <div class="btn-row">
        <a class="btn" href="/resume/">View resume <Icon name="arrow-right" size={16} /></a>
        <a class="btn btn-outline" href="/projects/">Projects</a>
        <a class="btn btn-outline" href={`mailto:${site.email}`}><Icon name="mail" size={16} /> Get in touch</a>
      </div>
    </div>
  </section>

  <section class="container now">
    <div class="now-card">
      <p class="eyebrow">Now</p>
      <p>
        Processing and correcting solar irradiance data from the <a href="https://lasp.colorado.edu/tsis/" rel="noopener noreferrer">TSIS-1</a> Spectral Irradiance Monitor on the International Space Station, and building tools that monitor the health of the pipeline and the instrument.
      </p>
    </div>
  </section>

  <section class="container section">
    <div class="section-head">
      <h2>Selected projects</h2>
      <a href="/projects/">All projects <Icon name="arrow-right" size={16} /></a>
    </div>
    <div class="grid">
      {featured.map((p) => <ProjectCard project={p} compact />)}
    </div>
  </section>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: clamp(1.5rem, 5vw, 3.5rem);
    padding-block: clamp(3rem, 9vw, 6rem) 2.5rem;
  }
  .hero > div {
    min-width: 0;
  }
  .avatar {
    width: 176px;
    height: 176px;
    border-radius: 50%;
    object-fit: cover;
    border: 4px solid var(--surface);
    box-shadow: 0 0 0 1px var(--border), var(--shadow-hover);
  }
  .lede {
    font-size: var(--step-1);
    line-height: 1.55;
    color: var(--text-muted);
    max-width: 40em;
    margin-bottom: 1.75rem;
  }
  .now-card {
    border-left: 3px solid var(--accent);
    background: var(--surface);
    border-radius: 0 var(--radius) var(--radius) 0;
    padding: 1.1rem 1.4rem;
    box-shadow: var(--shadow);
  }
  .now-card p:last-child {
    margin: 0;
  }
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 3.5rem;
    margin-bottom: 1.25rem;
  }
  .section-head h2 {
    margin: 0;
  }
  .section-head a {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    font-weight: 550;
    text-decoration: none;
    white-space: nowrap;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
    gap: 1.25rem;
  }
  @media (max-width: 40rem) {
    .hero {
      grid-template-columns: 1fr;
      text-align: left;
    }
    .avatar {
      width: 120px;
      height: 120px;
    }
  }
</style>
