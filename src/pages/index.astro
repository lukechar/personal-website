---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ProjectCard from '../components/ProjectCard.astro';
import avatar from '../assets/luke_pass.jpg';
import mountainRiver from '../assets/mountain_river.jpg';
import { projects } from '../data/projects';
import { site } from '../data/site';

const featured = projects.filter((p) => p.featured);
---

<Base>
  <section class="hero">
    <Image
      src={mountainRiver}
      alt=""
      widths={[800, 1400, 1800]}
      sizes="100vw"
      class="hero-bg"
      loading="eager"
      fetchpriority="high"
    />
    <div class="container hero-inner">
      <Image
        src={avatar}
        alt="Luke at the top of a mountain pass"
        widths={[176, 352]}
        sizes="176px"
        class="avatar"
        loading="eager"
      />
      <div>
        <h1>{site.name}</h1>
        <p class="subtitle">{site.title}</p>
        <p class="lede">
          I build data processing pipelines for NASA missions at the <a href="https://lasp.colorado.edu/" rel="noopener noreferrer">Laboratory for Atmospheric and Space Physics</a>. My background is in experimental physics with ultrafast lasers, and I still enjoy work where code meets real-world measurement.
        </p>
        <div class="btn-row">
          <a class="btn btn-light" href="/resume/">View resume <Icon name="arrow-right" size={16} /></a>
          <a class="btn btn-ghost" href="/projects/">Projects</a>
          <a class="btn btn-ghost" href={`mailto:${site.email}`}><Icon name="mail" size={16} /> Get in touch</a>
        </div>
      </div>
    </div>
  </section>

  <section class="container now">
    <div class="now-card">
      <p class="eyebrow">Now</p>
      <p>
        Processing and correcting solar irradiance data from the <a href="https://lasp.colorado.edu/tsis/" rel="noopener noreferrer">TSIS-1</a> Spectral Irradiance Monitor on the International Space Station, and building tools that monitor the health of the pipeline and the instrument.
      </p>
    </div>
  </section>

  <section class="container section">
    <div class="section-head">
      <h2>Selected projects</h2>
      <a href="/projects/">All projects <Icon name="arrow-right" size={16} /></a>
    </div>
    <div class="grid">
      {featured.map((p) => <ProjectCard project={p} compact />)}
    </div>
  </section>
</Base>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    color: #f8f8f8;
    background: #1d2a30;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  /* Darken the photo so white text stays readable everywhere on it. */
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(100deg, rgb(8 14 18 / 0.72) 0%, rgb(8 14 18 / 0.45) 55%, rgb(8 14 18 / 0.2) 100%);
  }
  .hero-inner {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: clamp(1.5rem, 5vw, 3.5rem);
    padding-block: clamp(4rem, 12vw, 8rem);
  }
  .hero-inner > div {
    min-width: 0;
  }
  .hero h1 {
    margin-bottom: 0.25rem;
    text-shadow: 0 2px 12px rgb(0 0 0 / 0.35);
  }
  .subtitle {
    font-size: var(--step-1);
    font-weight: 500;
    letter-spacing: 0.01em;
    color: #9be3dc;
    margin-bottom: 1.25rem;
  }
  .avatar {
    width: 176px;
    height: 176px;
    border-radius: 50%;
    object-fit: cover;
    border: 4px solid rgb(255 255 255 / 0.9);
    box-shadow: 0 8px 30px rgb(0 0 0 / 0.35);
  }
  .lede {
    font-size: var(--step-1);
    line-height: 1.55;
    color: rgb(248 248 248 / 0.9);
    max-width: 40em;
    margin-bottom: 1.75rem;
  }
  .lede a {
    color: #fff;
    text-decoration-color: rgb(255 255 255 / 0.6);
  }
  .lede a:hover {
    color: #fff;
    text-decoration-color: #fff;
  }
  .btn-light {
    background: #fff;
    border-color: #fff;
    color: #0b2b2b;
  }
  .btn-light:hover {
    background: #dff3f1;
    border-color: #dff3f1;
    color: #0b2b2b;
  }
  .btn-ghost {
    background: rgb(255 255 255 / 0.08);
    border-color: rgb(255 255 255 / 0.55);
    color: #fff;
  }
  .btn-ghost:hover {
    background: rgb(255 255 255 / 0.18);
    border-color: #fff;
    color: #fff;
  }
  .hero :focus-visible {
    outline-color: #fff;
  }
  .now {
    margin-top: 2.5rem;
  }
  .now-card {
    border-left: 3px solid var(--accent);
    background: var(--surface);
    border-radius: 0 var(--radius) var(--radius) 0;
    padding: 1.1rem 1.4rem;
    box-shadow: var(--shadow);
  }
  .now-card p:last-child {
    margin: 0;
  }
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 3.5rem;
    margin-bottom: 1.25rem;
  }
  .section-head h2 {
    margin: 0;
  }
  .section-head a {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    font-weight: 550;
    text-decoration: none;
    white-space: nowrap;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
    gap: 1.25rem;
  }
  @media (max-width: 40rem) {
    .hero-inner {
      grid-template-columns: 1fr;
    }
    .avatar {
      width: 120px;
      height: 120px;
    }
  }
</style>
